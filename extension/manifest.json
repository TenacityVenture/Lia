{
  "manifest_version": 3,
  "name": "LIA - LinkedIn Intelligent Assistant",
  "version": "2.4.0",
  "description": "AI-powered assistant for LinkedIn posts and comments. Generate, edit, improve and enhance your LinkedIn presence with ease.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/feed/*",
        "https://www.linkedin.com/in/*",
        "https://www.linkedin.com/company/*",
        "https://www.linkedin.com/groups/*",
        "https://www.linkedin.com/posts/*",
        "https://www.linkedin.com/newsletters/*",
        "https://www.linkedin.com/pulse/*",
        "https://www.linkedin.com/showcase/*",
        "https://www.linkedin.com/events/*",
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/search/*",
        "https://www.linkedin.com/people/*",
        "https://www.linkedin.com/hashtag/*",
        "https://www.linkedin.com/notifications/*",
        "https://www.linkedin.com/settings/*",
        "https://www.linkedin.com/messaging/*",
        "https://www.linkedin.com/sales/*",
        "https://www.linkedin.com/learning/*",
        "https://www.getlia.live/*"
      ],
      "js": [
        "src/content.tsx",
        "src/linkedin-mention-handler.ts",
        "src/utils/helpers.ts",
        "src/utils/utility.ts"
      ],
      "css": [
        "css/content.css",
        "css/profile-card.css",
        "css/customization-modal.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
